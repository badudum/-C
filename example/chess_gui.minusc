absInt = ({v} int) function {
    if (v < 0) {
        return 0 - v;
    };
    return v;
} int;

signInt = ({v} int) function {
    if (v > 0) {
        return 1;
    };
    if (v < 0) {
        return 0 - 1;
    };
    return 0;
} int;

sqX = ({f} int) function {
    {v} int = f * 100;
    v = v - 350;
    return v;
} int;

sqZ = ({r} int) function {
    {v} int = r * 100;
    v = 350 - v;
    return v;
} int;

drawPawn = ({x} int, {z} int, {c} int, {lift} int) function {
    {y0} int = 28 + lift;
    {y1} int = 48 + lift;
    {y2} int = 70 + lift;
    {a} int = GuiBox(x, y0, z, 42, 16, 42, c);
    {b} int = GuiBox(x, y1, z, 18, 32, 18, c);
    {d} int = GuiBox(x, y2, z, 28, 20, 28, c);
    return 0;
} int;

drawRook = ({x} int, {z} int, {c} int, {lift} int) function {
    {y0} int = 28 + lift;
    {y1} int = 58 + lift;
    {y2} int = 90 + lift;
    {y3} int = 102 + lift;
    {a} int = GuiBox(x, y0, z, 46, 16, 46, c);
    {b} int = GuiBox(x, y1, z, 32, 52, 32, c);
    {d} int = GuiBox(x, y2, z, 46, 12, 46, c);
    {e} int = GuiBox(x - 16, y3, z - 16, 12, 16, 12, c);
    {f} int = GuiBox(x + 16, y3, z - 16, 12, 16, 12, c);
    {g} int = GuiBox(x - 16, y3, z + 16, 12, 16, 12, c);
    {h} int = GuiBox(x + 16, y3, z + 16, 12, 16, 12, c);
    return 0;
} int;

drawKnight = ({x} int, {z} int, {c} int, {lift} int) function {
    {y0} int = 26 + lift;
    {y1} int = 54 + lift;
    {y2} int = 78 + lift;
    {y3} int = 92 + lift;
    {a} int = GuiBox(x, y0, z, 44, 16, 40, c);
    {b} int = GuiBox(x, y1, z + 4, 24, 44, 28, c);
    {d} int = GuiBox(x, y2, z - 10, 22, 28, 36, c);
    {e} int = GuiBox(x + 8, y3, z - 22, 14, 16, 16, c);
    return 0;
} int;

drawBishop = ({x} int, {z} int, {c} int, {lift} int) function {
    {y0} int = 26 + lift;
    {y1} int = 52 + lift;
    {y2} int = 82 + lift;
    {y3} int = 102 + lift;
    {y4} int = 114 + lift;
    {a} int = GuiBox(x, y0, z, 42, 14, 42, c);
    {b} int = GuiBox(x, y1, z, 22, 40, 22, c);
    {d} int = GuiBox(x, y2, z, 16, 28, 16, c);
    {e} int = GuiBox(x, y3, z, 10, 16, 10, c);
    {f} int = GuiBox(x, y4, z, 6, 10, 6, c);
    return 0;
} int;

drawQueen = ({x} int, {z} int, {c} int, {lift} int) function {
    {y0} int = 26 + lift;
    {y1} int = 54 + lift;
    {y2} int = 84 + lift;
    {y3} int = 102 + lift;
    {y4} int = 98 + lift;
    {a} int = GuiBox(x, y0, z, 46, 14, 46, c);
    {b} int = GuiBox(x, y1, z, 24, 44, 24, c);
    {d} int = GuiBox(x, y2, z, 36, 16, 36, c);
    {e} int = GuiBox(x, y3, z, 8, 22, 8, c);
    {f} int = GuiBox(x - 14, y4, z, 8, 16, 8, c);
    {g} int = GuiBox(x + 14, y4, z, 8, 16, 8, c);
    {h} int = GuiBox(x, y4, z - 14, 8, 16, 8, c);
    {i} int = GuiBox(x, y4, z + 14, 8, 16, 8, c);
    return 0;
} int;

drawKing = ({x} int, {z} int, {c} int, {lift} int) function {
    {y0} int = 26 + lift;
    {y1} int = 56 + lift;
    {y2} int = 88 + lift;
    {y3} int = 108 + lift;
    {y4} int = 112 + lift;
    {a} int = GuiBox(x, y0, z, 46, 14, 46, c);
    {b} int = GuiBox(x, y1, z, 26, 48, 26, c);
    {d} int = GuiBox(x, y2, z, 34, 14, 34, c);
    {e} int = GuiBox(x, y3, z, 8, 28, 8, c);
    {f} int = GuiBox(x, y4, z, 24, 8, 8, c);
    return 0;
} int;

drawPiece = ({x} int, {z} int, {piece} int, {lift} int) function {
    {kind} int = piece;
    if (piece > 6) {
        kind = piece - 6;
    };
    {c} int = 1776411;
    if (piece <= 6) {
        c = 15724527;
    };
    if (kind == 1) {
        {p} int = drawPawn(x, z, c, lift);
    };
    if (kind == 2) {
        {n} int = drawKnight(x, z, c, lift);
    };
    if (kind == 3) {
        {b} int = drawBishop(x, z, c, lift);
    };
    if (kind == 4) {
        {k} int = drawRook(x, z, c, lift);
    };
    if (kind == 5) {
        {q} int = drawQueen(x, z, c, lift);
    };
    if (kind == 6) {
        {g} int = drawKing(x, z, c, lift);
    };
    return 0;
} int;

lerp100 = ({a} int, {b} int, {u} int) function {
    if (u < 0) {
        u = 0;
    };
    if (u > 100) {
        u = 100;
    };
    if (b >= a) {
        {d} int = b - a;
        {p} int = d * u;
        p = p / 100;
        return a + p;
    };
    {d2} int = a - b;
    {p2} int = d2 * u;
    p2 = p2 / 100;
    return a - p2;
} int;

ease100 = ({t} int) function {
    {u} int = t;
    if (u < 0) {
        u = 0;
    };
    if (u > 100) {
        u = 100;
    };
    {s} int = u * u;
    {k} int = 300 - 2 * u;
    s = s * k;
    s = s / 10000;
    return s;
} int;

drawAnimFrame = ({from} int, {to} int, {piece} int, {victim} int, {t} int, {dur} int, {mode} int) function {
    {ff} int = from % 8;
    {fr} int = from / 8;
    {tf} int = to % 8;
    {tr} int = to / 8;
    {x0} int = sqX(ff);
    {z0} int = sqZ(fr);
    {x1} int = sqX(tf);
    {z1} int = sqZ(tr);
    {span} int = dur - 1;
    if (span < 1) {
        span = 1;
    };
    {raw} int = t * 100;
    raw = raw / span;
    {u} int = ease100(raw);
    {mx} int = x0;
    {mz} int = z0;
    {hop} int = 0;
    {vLift} int = 0;
    {showV} int = 0;
    if (mode == 1) {
        mx = lerp100(x0, x1, u);
        mz = lerp100(z0, z1, u);
        hop = u * (100 - u);
        hop = hop / 24;
    };
    if (mode == 2) {
        if (u < 62) {
            {tu} int = u * 100;
            tu = tu / 62;
            {teu} int = ease100(tu);
            mx = lerp100(x0, x1, teu);
            mz = lerp100(z0, z1, teu);
            {arc} int = tu * (100 - tu);
            arc = arc / 36;
            hop = teu * 58;
            hop = hop / 100;
            hop = hop + arc;
            showV = 1;
            vLift = 0;
        };
        if (u >= 62) {
            mx = x1;
            mz = z1;
            {su} int = u - 62;
            su = su * 100;
            su = su / 38;
            if (su > 100) {
                su = 100;
            };
            {seu} int = ease100(su);
            hop = lerp100(58, 0 - 16, seu);
            vLift = lerp100(8, 0 - 82, seu);
            if (seu < 90) {
                showV = 1;
            };
        };
    };
    {shad} int = GuiBox(mx, 16, mz, 48, 6, 48, 2631720);
    if (mode == 2) {
        if (showV == 1) {
            {dv} int = drawPiece(x1, z1, victim, vLift);
        };
        if (u >= 62) {
            {crush} int = GuiBox(x1, 14, z1, 100, 8, 100, 9050112);
        };
    };
    {dm} int = drawPiece(mx, mz, piece, hop);
    return 0;
} int;

setupBoard = ({board} adr) function {
    Memset(board, 0, 64);
    PokeByte(board, 0, 4);
    PokeByte(board, 1, 2);
    PokeByte(board, 2, 3);
    PokeByte(board, 3, 5);
    PokeByte(board, 4, 6);
    PokeByte(board, 5, 3);
    PokeByte(board, 6, 2);
    PokeByte(board, 7, 4);
    PokeByte(board, 56, 10);
    PokeByte(board, 57, 8);
    PokeByte(board, 58, 9);
    PokeByte(board, 59, 11);
    PokeByte(board, 60, 12);
    PokeByte(board, 61, 9);
    PokeByte(board, 62, 8);
    PokeByte(board, 63, 10);
    loop until ({f} int = 0; f < 8; f++) {
        PokeByte(board, 8 + f, 1);
        PokeByte(board, 48 + f, 7);
    };
    return 0;
} int;

clearPath = ({board} adr, {from} int, {to} int) function {
    {fr} int = from / 8;
    {ff} int = from % 8;
    {tr} int = to / 8;
    {tf} int = to % 8;
    {sr} int = signInt(tr - fr);
    {sf} int = signInt(tf - ff);
    {r} int = fr + sr;
    {f} int = ff + sf;
    loop until (r != tr or f != tf) {
        if (PeekByte(board, r * 8 + f) != 0) {
            return 0;
        };
        r += sr;
        f += sf;
    };
    return 1;
} int;

legalMove = ({board} adr, {from} int, {to} int, {turn} int) function {
    if (from == to) {
        return 0;
    };
    {piece} int = PeekByte(board, from);
    if (piece == 0) {
        return 0;
    };
    {isW} int = 0;
    if (piece <= 6) {
        isW = 1;
    };
    if (turn == 0 and isW == 0) {
        return 0;
    };
    if (turn == 1 and isW == 1) {
        return 0;
    };
    {target} int = PeekByte(board, to);
    if (target != 0) {
        {tw} int = 0;
        if (target <= 6) {
            tw = 1;
        };
        if (tw == isW) {
            return 0;
        };
    };
    {fr} int = from / 8;
    {ff} int = from % 8;
    {tr} int = to / 8;
    {tf} int = to % 8;
    {dr} int = tr - fr;
    {df} int = tf - ff;
    {absDr} int = absInt(dr);
    {absDf} int = absInt(df);
    {kind} int = piece;
    if (piece > 6) {
        kind = piece - 6;
    };
    if (kind == 1) {
        {dir} int = 1;
        {startR} int = 1;
        if (isW == 0) {
            dir = 0 - 1;
            startR = 6;
        };
        if (df == 0 and target == 0) {
            if (dr == dir) {
                return 1;
            };
            if (dr == 2 * dir and fr == startR) {
                if (PeekByte(board, from + dir * 8) == 0) {
                    return 1;
                };
            };
        };
        if (absDf == 1 and dr == dir and target != 0) {
            return 1;
        };
        return 0;
    };
    if (kind == 2) {
        if (absDf == 1 and absDr == 2) {
            return 1;
        };
        if (absDf == 2 and absDr == 1) {
            return 1;
        };
        return 0;
    };
    if (kind == 3) {
        if (absDf == absDr) {
            return clearPath(board, from, to);
        };
        return 0;
    };
    if (kind == 4) {
        if (df == 0 or dr == 0) {
            return clearPath(board, from, to);
        };
        return 0;
    };
    if (kind == 5) {
        if (absDf == absDr or df == 0 or dr == 0) {
            return clearPath(board, from, to);
        };
        return 0;
    };
    if (kind == 6) {
        if (absDf <= 1 and absDr <= 1) {
            return 1;
        };
        return 0;
    };
    return 0;
} int;

drawBoard = ({board} adr, {sel} int, {skipA} int, {skipB} int) function {
    {bg} int = GuiClear(1710618);
    {cam} int = GuiCam(0, 620, 980, 0, 0, 40);
    {lit} int = GuiLight(40, 90, 55);
    {tbl} int = GuiBox(0, 0 - 6, 0, 880, 12, 880, 4852250);
    loop until ({r} int = 0; r < 8; r++) {
        loop until ({f} int = 0; f < 8; f++) {
            {sq} int = r * 8 + f;
            {cx} int = sqX(f);
            {cz} int = sqZ(r);
            {shade} int = (r + f) % 2;
            {color} int = 11897955;
            if (shade == 1) {
                color = 15784373;
            };
            if (sq == sel) {
                color = 7249990;
            };
            {id} int = GuiId(sq);
            {cell} int = GuiBox(cx, 10, cz, 100, 20, 100, color);
            {piece} int = PeekByte(board, sq);
            if (piece != 0) {
                if (sq != skipA) {
                    if (sq != skipB) {
                        {lift} int = 0;
                        if (sq == sel) {
                            lift = 14;
                        };
                        {dp} int = drawPiece(cx, cz, piece, lift);
                    };
                };
            };
        };
    };
    {clr} int = GuiId(0 - 1);
    return 0;
} int;

drawStatus = ({state} int) function {
    GuiRect(0, 640, 800, 40, 2631720);
    if (state == 0) {
        GuiText(20, 652, "WHITE TO MOVE", 15263976, 2);
    };
    if (state == 1) {
        GuiText(20, 652, "BLACK TO MOVE", 15263976, 2);
    };
    if (state == 2) {
        GuiText(20, 652, "WHITE WINS! PRESS R", 16766720, 2);
    };
    if (state == 3) {
        GuiText(20, 652, "BLACK WINS! PRESS R", 15263976, 2);
    };
    if (state == 4) {
        GuiText(20, 652, "ILLEGAL MOVE", 16733525, 2);
    };
    GuiText(520, 652, "MMB ORBIT  Q/R", 9013641, 2);
    return 0;
} int;

main = ({x} int) function {
    {r} int = GuiOpen(800, 680, "minusC chess");
    if (r < 0) {
        HelloWorldLine("GUI not available on this platform");
        return 1;
    };
    {board} adr = rent(64);
    {s} int = setupBoard(board);
    {turn} int = 0;
    {sel} int = 0 - 1;
    {state} int = 0;
    {running} int = 1;
    {anim} int = 0;
    {animT} int = 0;
    {animDur} int = 22;
    {animFrom} int = 0;
    {animTo} int = 0;
    {animPiece} int = 0;
    {animVictim} int = 0;
    loop until (running == 1) {
        {ev} int = GuiPoll();
        if (ev == 1) {
            running = 0;
        };
        if (ev == 2) {
            {key} int = GuiEventKey();
            if (key == 113) {
                running = 0;
            };
            if (key == 114) {
                {rs} int = setupBoard(board);
                turn = 0;
                sel = 0 - 1;
                state = 0;
                anim = 0;
                animT = 0;
            };
            if (key == 115) {
                {sv} int = GuiSave("chess_shot.bmp");
            };
        };
        if (ev == 3 and anim == 0 and (state < 2 or state == 4)) {
            if (state == 4) {
                state = turn;
            };
            {mx} int = GuiEventX();
            {my} int = GuiEventY();
            if (my < 640) {
                {sq} int = GuiHit(mx, my);
                if (sq >= 0) {
                    if (sel < 0) {
                        {piece} int = PeekByte(board, sq);
                        if (piece != 0) {
                            {isW} int = 0;
                            if (piece <= 6) {
                                isW = 1;
                            };
                            if (turn == 0 and isW == 1) {
                                sel = sq;
                                state = turn;
                            };
                            if (turn == 1 and isW == 0) {
                                sel = sq;
                                state = turn;
                            };
                        };
                    } else if (sq == sel) {
                        sel = 0 - 1;
                        state = turn;
                    } else {
                        {ok} int = legalMove(board, sel, sq, turn);
                        if (ok == 1) {
                            animVictim = PeekByte(board, sq);
                            animPiece = PeekByte(board, sel);
                            animFrom = sel;
                            animTo = sq;
                            animT = 0;
                            animDur = 26;
                            anim = 1;
                            if (animVictim != 0) {
                                anim = 2;
                                animDur = 38;
                            };
                            sel = 0 - 1;
                        } else {
                            sel = 0 - 1;
                            state = 4;
                        };
                    };
                };
            };
        };
        {skipA} int = 0 - 1;
        {skipB} int = 0 - 1;
        {hl} int = sel;
        if (anim != 0) {
            skipA = animFrom;
            skipB = animTo;
            hl = animTo;
        };
        {d1} int = drawBoard(board, hl, skipA, skipB);
        if (anim != 0) {
            {da} int = drawAnimFrame(animFrom, animTo, animPiece, animVictim, animT, animDur, anim);
            animT++;
            if (animT >= animDur) {
                PokeByte(board, animTo, animPiece);
                PokeByte(board, animFrom, 0);
                if (animPiece == 1) {
                    if (animTo / 8 == 7) {
                        PokeByte(board, animTo, 5);
                    };
                };
                if (animPiece == 7) {
                    if (animTo / 8 == 0) {
                        PokeByte(board, animTo, 11);
                    };
                };
                if (animVictim == 12) {
                    state = 2;
                } else if (animVictim == 6) {
                    state = 3;
                } else {
                    turn = 1 - turn;
                    state = turn;
                };
                anim = 0;
                animT = 0;
            };
        };
        {d2} int = drawStatus(state);
        GuiPresent();
        GuiSleep(16);
    };
    {c} int = GuiClose();
    {fd} int = moveOut(board);
    return 0;
} int;
