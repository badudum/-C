absInt = ({v} int) function {
    if (v < 0) {
        return 0 - v;
    };
    return v;
} int;

signInt = ({v} int) function {
    if (v > 0) {
        return 1;
    };
    if (v < 0) {
        return 0 - 1;
    };
    return 0;
} int;

sqX = ({f} int) function {
    {v} int = f * 100;
    v = v - 350;
    return v;
} int;

sqZ = ({r} int) function {
    {v} int = r * 100;
    v = 350 - v;
    return v;
} int;

drawPawn = ({x} int, {z} int, {c} int) function {
    {a} int = GuiBox(x, 28, z, 42, 16, 42, c);
    {b} int = GuiBox(x, 48, z, 18, 32, 18, c);
    {d} int = GuiBox(x, 70, z, 28, 20, 28, c);
    return 0;
} int;

drawRook = ({x} int, {z} int, {c} int) function {
    {a} int = GuiBox(x, 28, z, 46, 16, 46, c);
    {b} int = GuiBox(x, 58, z, 32, 52, 32, c);
    {d} int = GuiBox(x, 90, z, 46, 12, 46, c);
    {e} int = GuiBox(x - 16, 102, z - 16, 12, 16, 12, c);
    {f} int = GuiBox(x + 16, 102, z - 16, 12, 16, 12, c);
    {g} int = GuiBox(x - 16, 102, z + 16, 12, 16, 12, c);
    {h} int = GuiBox(x + 16, 102, z + 16, 12, 16, 12, c);
    return 0;
} int;

drawKnight = ({x} int, {z} int, {c} int) function {
    {a} int = GuiBox(x, 26, z, 44, 16, 40, c);
    {b} int = GuiBox(x, 54, z + 4, 24, 44, 28, c);
    {d} int = GuiBox(x, 78, z - 10, 22, 28, 36, c);
    {e} int = GuiBox(x + 8, 92, z - 22, 14, 16, 16, c);
    return 0;
} int;

drawBishop = ({x} int, {z} int, {c} int) function {
    {a} int = GuiBox(x, 26, z, 42, 14, 42, c);
    {b} int = GuiBox(x, 52, z, 22, 40, 22, c);
    {d} int = GuiBox(x, 82, z, 16, 28, 16, c);
    {e} int = GuiBox(x, 102, z, 10, 16, 10, c);
    {f} int = GuiBox(x, 114, z, 6, 10, 6, c);
    return 0;
} int;

drawQueen = ({x} int, {z} int, {c} int) function {
    {a} int = GuiBox(x, 26, z, 46, 14, 46, c);
    {b} int = GuiBox(x, 54, z, 24, 44, 24, c);
    {d} int = GuiBox(x, 84, z, 36, 16, 36, c);
    {e} int = GuiBox(x, 102, z, 8, 22, 8, c);
    {f} int = GuiBox(x - 14, 98, z, 8, 16, 8, c);
    {g} int = GuiBox(x + 14, 98, z, 8, 16, 8, c);
    {h} int = GuiBox(x, 98, z - 14, 8, 16, 8, c);
    {i} int = GuiBox(x, 98, z + 14, 8, 16, 8, c);
    return 0;
} int;

drawKing = ({x} int, {z} int, {c} int) function {
    {a} int = GuiBox(x, 26, z, 46, 14, 46, c);
    {b} int = GuiBox(x, 56, z, 26, 48, 26, c);
    {d} int = GuiBox(x, 88, z, 34, 14, 34, c);
    {e} int = GuiBox(x, 108, z, 8, 28, 8, c);
    {f} int = GuiBox(x, 112, z, 24, 8, 8, c);
    return 0;
} int;

drawPiece = ({x} int, {z} int, {piece} int) function {
    {kind} int = piece;
    if (piece > 6) {
        kind = piece - 6;
    };
    {c} int = 1776411;
    if (piece <= 6) {
        c = 15724527;
    };
    if (kind == 1) {
        {p} int = drawPawn(x, z, c);
    };
    if (kind == 2) {
        {n} int = drawKnight(x, z, c);
    };
    if (kind == 3) {
        {b} int = drawBishop(x, z, c);
    };
    if (kind == 4) {
        {k} int = drawRook(x, z, c);
    };
    if (kind == 5) {
        {q} int = drawQueen(x, z, c);
    };
    if (kind == 6) {
        {g} int = drawKing(x, z, c);
    };
    return 0;
} int;

setupBoard = ({board} adr) function {
    Memset(board, 0, 64);
    PokeByte(board, 0, 4);
    PokeByte(board, 1, 2);
    PokeByte(board, 2, 3);
    PokeByte(board, 3, 5);
    PokeByte(board, 4, 6);
    PokeByte(board, 5, 3);
    PokeByte(board, 6, 2);
    PokeByte(board, 7, 4);
    PokeByte(board, 56, 10);
    PokeByte(board, 57, 8);
    PokeByte(board, 58, 9);
    PokeByte(board, 59, 11);
    PokeByte(board, 60, 12);
    PokeByte(board, 61, 9);
    PokeByte(board, 62, 8);
    PokeByte(board, 63, 10);
    loop until ({f} int = 0; f < 8; f++) {
        PokeByte(board, 8 + f, 1);
        PokeByte(board, 48 + f, 7);
    };
    return 0;
} int;

clearPath = ({board} adr, {from} int, {to} int) function {
    {fr} int = from / 8;
    {ff} int = from % 8;
    {tr} int = to / 8;
    {tf} int = to % 8;
    {sr} int = signInt(tr - fr);
    {sf} int = signInt(tf - ff);
    {r} int = fr + sr;
    {f} int = ff + sf;
    loop until (r != tr or f != tf) {
        if (PeekByte(board, r * 8 + f) != 0) {
            return 0;
        };
        r += sr;
        f += sf;
    };
    return 1;
} int;

legalMove = ({board} adr, {from} int, {to} int, {turn} int) function {
    if (from == to) {
        return 0;
    };
    {piece} int = PeekByte(board, from);
    if (piece == 0) {
        return 0;
    };
    {isW} int = 0;
    if (piece <= 6) {
        isW = 1;
    };
    if (turn == 0 and isW == 0) {
        return 0;
    };
    if (turn == 1 and isW == 1) {
        return 0;
    };
    {target} int = PeekByte(board, to);
    if (target != 0) {
        {tw} int = 0;
        if (target <= 6) {
            tw = 1;
        };
        if (tw == isW) {
            return 0;
        };
    };
    {fr} int = from / 8;
    {ff} int = from % 8;
    {tr} int = to / 8;
    {tf} int = to % 8;
    {dr} int = tr - fr;
    {df} int = tf - ff;
    {absDr} int = absInt(dr);
    {absDf} int = absInt(df);
    {kind} int = piece;
    if (piece > 6) {
        kind = piece - 6;
    };
    if (kind == 1) {
        {dir} int = 1;
        {startR} int = 1;
        if (isW == 0) {
            dir = 0 - 1;
            startR = 6;
        };
        if (df == 0 and target == 0) {
            if (dr == dir) {
                return 1;
            };
            if (dr == 2 * dir and fr == startR) {
                if (PeekByte(board, from + dir * 8) == 0) {
                    return 1;
                };
            };
        };
        if (absDf == 1 and dr == dir and target != 0) {
            return 1;
        };
        return 0;
    };
    if (kind == 2) {
        if (absDf == 1 and absDr == 2) {
            return 1;
        };
        if (absDf == 2 and absDr == 1) {
            return 1;
        };
        return 0;
    };
    if (kind == 3) {
        if (absDf == absDr) {
            return clearPath(board, from, to);
        };
        return 0;
    };
    if (kind == 4) {
        if (df == 0 or dr == 0) {
            return clearPath(board, from, to);
        };
        return 0;
    };
    if (kind == 5) {
        if (absDf == absDr or df == 0 or dr == 0) {
            return clearPath(board, from, to);
        };
        return 0;
    };
    if (kind == 6) {
        if (absDf <= 1 and absDr <= 1) {
            return 1;
        };
        return 0;
    };
    return 0;
} int;

drawBoard = ({board} adr, {sel} int) function {
    {bg} int = GuiClear(1710618);
    {cam} int = GuiCam(0, 620, 980, 0, 0, 40);
    {lit} int = GuiLight(40, 90, 55);
    {tbl} int = GuiBox(0, 0 - 6, 0, 880, 12, 880, 4852250);
    loop until ({r} int = 0; r < 8; r++) {
        loop until ({f} int = 0; f < 8; f++) {
            {sq} int = r * 8 + f;
            {cx} int = sqX(f);
            {cz} int = sqZ(r);
            {shade} int = (r + f) % 2;
            {color} int = 11897955;
            if (shade == 1) {
                color = 15784373;
            };
            if (sq == sel) {
                color = 7249990;
            };
            {id} int = GuiId(sq);
            {cell} int = GuiBox(cx, 10, cz, 100, 20, 100, color);
            {piece} int = PeekByte(board, sq);
            if (piece != 0) {
                {dp} int = drawPiece(cx, cz, piece);
            };
        };
    };
    {clr} int = GuiId(0 - 1);
    return 0;
} int;

drawStatus = ({state} int) function {
    GuiRect(0, 640, 800, 40, 2631720);
    if (state == 0) {
        GuiText(20, 652, "WHITE TO MOVE", 15263976, 2);
    };
    if (state == 1) {
        GuiText(20, 652, "BLACK TO MOVE", 15263976, 2);
    };
    if (state == 2) {
        GuiText(20, 652, "WHITE WINS! PRESS R", 16766720, 2);
    };
    if (state == 3) {
        GuiText(20, 652, "BLACK WINS! PRESS R", 15263976, 2);
    };
    if (state == 4) {
        GuiText(20, 652, "ILLEGAL MOVE", 16733525, 2);
    };
    GuiText(520, 652, "MMB ORBIT  Q/R", 9013641, 2);
    return 0;
} int;

main = ({x} int) function {
    {r} int = GuiOpen(800, 680, "minusC chess");
    if (r < 0) {
        HelloWorldLine("GUI not available on this platform");
        return 1;
    };
    {board} adr = rent(64);
    {s} int = setupBoard(board);
    {turn} int = 0;
    {sel} int = 0 - 1;
    {state} int = 0;
    {running} int = 1;
    loop until (running == 1) {
        {ev} int = GuiPoll();
        if (ev == 1) {
            running = 0;
        };
        if (ev == 2) {
            {key} int = GuiEventKey();
            if (key == 113) {
                running = 0;
            };
            if (key == 114) {
                {rs} int = setupBoard(board);
                turn = 0;
                sel = 0 - 1;
                state = 0;
            };
            if (key == 115) {
                {sv} int = GuiSave("chess_shot.bmp");
            };
        };
        if (ev == 3 and (state < 2 or state == 4)) {
            if (state == 4) {
                state = turn;
            };
            {mx} int = GuiEventX();
            {my} int = GuiEventY();
            if (my < 640) {
                {sq} int = GuiHit(mx, my);
                if (sq >= 0) {
                    if (sel < 0) {
                        {piece} int = PeekByte(board, sq);
                        if (piece != 0) {
                            {isW} int = 0;
                            if (piece <= 6) {
                                isW = 1;
                            };
                            if (turn == 0 and isW == 1) {
                                sel = sq;
                                state = turn;
                            };
                            if (turn == 1 and isW == 0) {
                                sel = sq;
                                state = turn;
                            };
                        };
                    } else if (sq == sel) {
                        sel = 0 - 1;
                        state = turn;
                    } else {
                        {ok} int = legalMove(board, sel, sq, turn);
                        if (ok == 1) {
                            {captured} int = PeekByte(board, sq);
                            {piece2} int = PeekByte(board, sel);
                            PokeByte(board, sq, piece2);
                            PokeByte(board, sel, 0);
                            if (piece2 == 1 and sq / 8 == 7) {
                                PokeByte(board, sq, 5);
                            };
                            if (piece2 == 7 and sq / 8 == 0) {
                                PokeByte(board, sq, 11);
                            };
                            sel = 0 - 1;
                            if (captured == 12) {
                                state = 2;
                            } else if (captured == 6) {
                                state = 3;
                            } else {
                                turn = 1 - turn;
                                state = turn;
                            };
                        } else {
                            sel = 0 - 1;
                            state = 4;
                        };
                    };
                };
            };
        };
        {d1} int = drawBoard(board, sel);
        {d2} int = drawStatus(state);
        GuiPresent();
        GuiSleep(16);
    };
    {c} int = GuiClose();
    {fd} int = moveOut(board);
    return 0;
} int;
